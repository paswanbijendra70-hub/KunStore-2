{
  "collections": [
    {
      "name": "users",
      "fields": [
        {"name": "uid", "type": "string"},
        {"name": "email", "type": "string"},
        {"name": "role", "type": "string", "description": "'user' or 'developer'"},
        {"name": "developerPlan", "type": "string", "description": "'free', 'payg', 'plan_100', 'plan_250'"}
      ]
    },
    {
      "name": "apps",
      "fields": [
        {"name": "developerId", "type": "string"},
        {"name": "name", "type": "string"},
        {"name": "description", "type": "string"},
        {"name": "icon", "type": "string"},
        {"name": "category", "type": "string"},
        {"name": "platforms", "type": "array"},
        {"name": "downloadUrl", "type": "string"},
        {"name": "downloads", "type": "number"},
        {"name": "rating", "type": "number"},
        {"name": "status", "type": "string", "description": "'published' or 'pending'"}
      ]
    }
  ]
}
